# iolocal_iozone job template
# IOzone throughput mode on the node-local IO target: write/rewrite,
# read/reread, random read/write with one thread per IO thread (all CPUs, or
# io_threads_max). Each thread writes its share of 2x the node's RAM so the
# page cache can't hold the data; sequential tests use the IO profile's block
# size as the record, random (IOPS) tests use 4k. gen-jobs fills in the sizes (cbench/python/cbench/iosizing.py).
#
# NOTE: bash syntax is used here
#
# Cbench job binary: CBENCHTEST_BIN_HERE/iozone (else bin/hwtests/iozone, else PATH)

IOZONE=CBENCHTEST_BIN_HERE/iozone
[ -x "$IOZONE" ] || IOZONE=CBENCHTEST_BIN_HERE/hwtests/iozone
[ -x "$IOZONE" ] || IOZONE=$(command -v iozone || echo CBENCHTEST_BIN_HERE/iozone)
cbench_check_for_bin $IOZONE

# iozone is single-node: it drives the node with its own thread count
if [ NUM_NODES_HERE -ne 1 ]; then
	cbench_echo "CBENCH NOTICE: iozone runs on 1 node only"
	exit
fi

# run on the configured node-local IO target, if any (cluster.yaml io_targets)
IO_TARGET_DIR="IO_TARGET_DIR_HERE"
if [ -n "$IO_TARGET_DIR" ]; then
	mkdir -p "$IO_TARGET_DIR" && cd "$IO_TARGET_DIR" || {
		cbench_echo "CBENCH NOTICE: cannot use IO target $IO_TARGET_DIR"; exit 1; }
fi
cbench_runin_tempdir

cbench_io_preflight "$PWD" "IO_REQUIRED_KB_HERE" "IO_CAVEAT_HERE"

threads=IOZONE_THREADS_HERE
files=""
for i in $(seq 1 $threads); do files="$files ./iozone.$i"; done
cbench_echo "Cbench iozone: profile=IOZONE_PROFILE_HERE record=IOZONE_RECORD_HERE iops_record=IOZONE_IOPS_RECORD_HERE threads=$threads size=IOZONE_SIZE_HERE"

# -e/-c include flush and close in the timing; -+n is NOT used so rewrite and
# reread run too. Throughput: -i 0 write/rewrite, -i 1 read/reread at the IO
# profile's record size. IOPS: -i 2 random read/write at 4k; iozone needs -i 0
# to lay the files out first, and the parser keeps the first run's write
# numbers, so that second write pass is not reported.
CMD="$IOZONE -i 0 -i 1 -e -c -t $threads -s IOZONE_SIZE_HERE -r IOZONE_RECORD_HERE -F $files"
cbench_run_cmd $CMD
rm -f $files
CMD="$IOZONE -i 0 -i 2 -e -c -t $threads -s IOZONE_SIZE_HERE -r IOZONE_IOPS_RECORD_HERE -F $files"
cbench_run_cmd $CMD
rm -f $files
cbench_echo "Cbench iozone: finished"
sync
