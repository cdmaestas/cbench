# iometadata_mdtest job template
# uses the mdtest benchmark to test io metadata performance
#
# NOTE: bash syntax is used here
#
# Cbench job binary: CBENCHTEST_BIN_HERE/mdtest

cbench_check_for_bin CBENCHTEST_BIN_HERE/mdtest

# run on the configured parallel IO target, if any (cluster.yaml io_targets)
IO_TARGET_DIR="IO_TARGET_DIR_HERE"
if [ -n "$IO_TARGET_DIR" ]; then
	mkdir -p "$IO_TARGET_DIR" && cd "$IO_TARGET_DIR" || {
		cbench_echo "CBENCH NOTICE: cannot use IO target $IO_TARGET_DIR"; exit 1; }
fi
cbench_runin_tempdir

CMD="JOBLAUNCH_CMD_HERE CBENCHTEST_BIN_HERE/mdtest -V 2 -i 50 -n 200"
cbench_run_cmd $CMD
