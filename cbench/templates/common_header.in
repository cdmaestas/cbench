# NOTE: bash syntax is used here

# beginning timestamp of the job
begin_time=`date --iso-8601=seconds`
begin_epoch=`date +%s`
cbench_echo "Cbench start timestamp: $begin_time"

# spit out some other useful Cbench specific details of this job
cbench_echo "Cbench test identifier: IDENT_HERE"
cbench_echo "Cbench CBENCHTEST: CBENCHTEST_HERE"
cbench_echo "Cbench job path: TESTSET_PATH_HERE/IDENT_HERE/JOBNAME_HERE"
cbench_echo "Cbench job script: TESTSET_PATH_HERE/IDENT_HERE/JOBNAME_HERE/JOBSCRIPT_HERE"
cbench_echo "Cbench jobid: $JOBID"

# We don't want to assume that the batch system or whatever will
# put us in the directory we want to be in for the job. So, we
# make sure we are where we expect to be. If that fails, stop: carrying on
# would run the benchmark (and write its output) wherever we happen to be.
cd "TESTSET_PATH_HERE/IDENT_HERE/JOBNAME_HERE" || {
	cbench_echo "CBENCH NOTICE: cannot cd to job directory TESTSET_PATH_HERE/IDENT_HERE/JOBNAME_HERE"
	exit 1
}

# Fail fast if an IO test's target lacks the space it needs. Checked right
# before the run: the free space nodecheck saw at generation time is only a
# snapshot. Defined here (not in cbench_functions) so it always ships with the
# generated script and can never be missing.
#   usage: cbench_io_preflight DIR REQUIRED_KB [CAVEAT]
cbench_io_preflight()
{
	local dir="$1" need_kb="$2" caveat="$3" have_kb
	if [ -n "$caveat" ]; then
		cbench_echo "CBENCH CAVEAT: $caveat"
	fi
	if [ -z "$need_kb" ]; then
		return 0
	fi
	mkdir -p "$dir" 2>/dev/null
	have_kb=$(df -Pk "$dir" 2>/dev/null | awk 'NR==2{print $4}')
	if [ -z "$have_kb" ]; then
		cbench_echo "CBENCH NOTICE: cannot determine free space on $dir"
		exit 1
	fi
	if [ "$have_kb" -lt "$need_kb" ]; then
		cbench_echo "CBENCH NOTICE: insufficient space on $dir: need ${need_kb} kB, have ${have_kb} kB"
		exit 1
	fi
	cbench_echo "Cbench IO preflight: $dir has ${have_kb} kB free, job needs ${need_kb} kB"
}

# interconnect / GPFS transport the node facts recorded (gen-jobs --nodefacts);
# `cbench parse` keeps the line in the result's status_detail. Labels are
# lowercase key=value pairs; empty, or uppercase (the bare token a Perl-rendered
# script leaves), prints nothing.
CBENCH_LABELS="CBENCH_LABELS_HERE"
case "$CBENCH_LABELS" in
	""|*[A-Z]*) ;;
	*) cbench_echo "CBENCH LABEL: $CBENCH_LABELS" ;;
esac

# set OMP_NUM_THREADS appropriate to the job
export OMP_NUM_THREADS=NUM_THREADS_PER_PROCESS_HERE
cbench_echo "Cbench OMP_NUM_THREADS: $OMP_NUM_THREADS"

# whitepace
cbench_echo ""

# dump out some information on the environment the job is running in for
# posterity
cbench_echo "======= Job Environment Info ========"
# check to see if Modules is being used and if so, list the loaded modules
set | egrep -q '^module.*()$'
if [ $? -eq 0 ]; then
	module list 2>&1 | while read tmp
	do
		cbench_echo "$tmp"
	done
	cbench_echo ""
fi
# dump some key environmental variables
env | egrep '^PATH|LD_LIBRARY_PATH|MODULE|OMPI_|^MPI' | sort | while read tmp
do
	cbench_echo "$tmp"
done

cbench_echo "====================================="
cbench_echo ""


