# io_ior job template
# IOR MPI filesystem test using posix, modeled after SWL posix IOR test
# N to N file access pattern
# NOTE: bash syntax is used here
#
# Cbench job binary: CBENCHTEST_BIN_HERE/ior (legacy name: IOR.posix)

# the unified hpc/ior build installs `ior`; fall back to the legacy IOR.posix name
IOR_BIN=CBENCHTEST_BIN_HERE/ior
[ -x "$IOR_BIN" ] || IOR_BIN=CBENCHTEST_BIN_HERE/IOR.posix
cbench_check_for_bin $IOR_BIN

# The block size, -b, is computed by gen-jobs so the aggregate written is at
# least 2x each node's RAM (rounded up to a multiple of -t), capped to the
# target's free space. See cbench/python/cbench/iosizing.py.
ALLARGS="-b IOR_BLOCKSIZE_HERE -C -i 4 -t 128m -v -v -r -R -w -W -e -d 30 -g "
TESTDIR="TESTDIR_HERE/$JOBID"
mkdir -p $TESTDIR
cbench_io_preflight "TESTDIR_HERE" "IO_REQUIRED_KB_HERE" "IO_CAVEAT_HERE"
PSFILE=`/bin/mktemp $TESTDIR/posix.nto1.XXXXXX`
PPFILE=`/bin/mktemp $TESTDIR/posix.nton.XXXXXX`

cbench_echo "Nto1 file: $PSFILE"
cbench_echo "NtoN files: $PPFILE"
cbench_echo "TESTDIR: $TESTDIR"
cbench_echo

# n-to-n file pattern
CMD="JOBLAUNCH_CMD_HERE $IOR_BIN -a POSIX $ALLARGS -F -o $PPFILE"
cbench_run_cmd $CMD

# quiet things down before the next job
sync
sleep 60
