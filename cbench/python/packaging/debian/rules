#!/usr/bin/make -f
# debian/rules for cbench — installs cbench, man pages, and docs.
# dpkg-buildpackage is invoked from packaging/Makefile which copies
# this debian/ directory into cbench/python/ temporarily.

export DH_VERBOSE = 1

SRCDIR   := $(CURDIR)
REPODIR  := $(CURDIR)/../..
PKGDIR   := $(SRCDIR)/packaging
LIBDIR   := /usr/lib/cbench
MANDIR   := /usr/share/man/man1
DOCDIR   := /usr/share/doc/cbench
MANSTAGE := $(PKGDIR)/_stage

%:
	dh $@ --with python3

override_dh_auto_configure:
	# Nothing to configure

override_dh_auto_build:
	# Nothing to compile

override_dh_auto_install:
	# Python package (no bundled deps — Depends: in control handles them)
	install -d debian/cbench$(LIBDIR)
	pip3 install --quiet --no-deps \
	    --target debian/cbench$(LIBDIR) \
	    $(SRCDIR)
	find debian/cbench$(LIBDIR) -name "*.py" \
	    -exec sed -i "s|$(CURDIR)/debian/cbench||g" {} \; 2>/dev/null || true

	# Wrapper script
	install -D -m 755 $(PKGDIR)/cbench.wrapper \
	    debian/cbench/usr/bin/cbench

	# Man pages (generated by `make man` in packaging/; reuse if present)
	if [ -d $(MANSTAGE)/usr/share/man/man1 ]; then \
	    install -d debian/cbench$(MANDIR); \
	    install -m 644 $(MANSTAGE)/usr/share/man/man1/*.1.gz \
	        debian/cbench$(MANDIR)/; \
	else \
	    echo "Warning: man pages not pre-generated; skipping."; \
	fi

	# Docs
	install -D -m 644 $(REPODIR)/README.md   debian/cbench$(DOCDIR)/README.md
	install -D -m 644 $(REPODIR)/CHANGELOG.md debian/cbench$(DOCDIR)/CHANGELOG.md

override_dh_auto_test:
	cd $(SRCDIR) && python3 -m pytest tests/ -q --no-header 2>/dev/null || true
